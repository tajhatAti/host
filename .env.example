# ===========================================
# Ahad Co - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub!
# ===========================================

# Email Service (Brevo/Sendinblue)
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Ahad Co

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave DATABASE_URL UNSET to use a local SQLite file (great for development —
# zero setup). Set it to a postgresql:// URL to use PostgreSQL (Supabase free
# tier) so your data persists permanently.
#
# Get this from Supabase Dashboard -> Project Settings -> Database ->
# "Connection string" -> "Session pooler" (port 5432) or "Transaction pooler"
# (port 6543). Paste it here, replacing [YOUR-PASSWORD].
#
#   DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
#
# When DATABASE_URL is unset, the app uses the SQLite file at DB_PATH instead:
DB_PATH=/app/data/database.db

# SSL mode for PostgreSQL. Supabase & most managed Postgres require SSL.
# "prefer" (default) uses SSL when available and falls back otherwise.
# Use "require" to force SSL, or "disable" for a local no-SSL dev server.
# PG_SSLMODE=prefer

# OTP Settings
OTP_EXPIRY_MINUTES=10

# ---------------------------------------------------------------------------
# CODE EXECUTION (runner service — SEPARATE Render service)
# ---------------------------------------------------------------------------
# These connect the main website to the separate code-runner service.
# The runner service has its own deploy (runner/ directory).
# Users NEVER see these — they stay server-side only.
#
# RUNNER_SERVICE_URL = the URL of the runner service after deploy.
#   Example: https://ahad-code-runner.onrender.com
# RUNNER_SERVICE_SECRET = a strong random string, SAME on both services.
#   Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# RUNNER_SERVICE_URL=
# RUNNER_SERVICE_SECRET=

# ── CAPACITY ─────────────────────────────────────────────────────────
# Two DIFFERENT limits. Conflating them is what once showed a brand-new
# account "Runner at capacity (5/5)" when the jobs belonged to other people.
#
# MAX_JOBS_PER_USER  fairness — how many bots ONE account may run at once.
#                    Enforced by the main site. Default 3.
# MAX_BG_JOBS        hardware — how many bots ONE runner container can hold.
#                    Set on the RUNNER service. Default 12, which suits a
#                    512MB Render instance. Do not raise it past what the RAM
#                    can actually hold; you will just get OOM kills.
#
# MAX_JOBS_PER_USER=3
# MAX_BG_JOBS=12
#
# ── SCALING OUT: more capacity = more runners ────────────────────────
# Each extra runner service is another 512MB, so the site ceiling becomes
# runners x MAX_BG_JOBS. Deploy runner/ again as a new Render service (same
# RUNNER_SERVICE_SECRET) and add its URL here, comma-separated:
#
# RUNNER_SERVICE_URLS=https://runner-b.onrender.com,https://runner-c.onrender.com
#
# A new job is placed on the first runner with room; when one reports itself
# full the site rolls to the next automatically. Existing jobs always keep
# talking to the runner they were created on.

# Python Version
PYTHON_VERSION=3.11

# ---------------------------------------------------------------------------
# TELEGRAM
# ---------------------------------------------------------------------------
# Token from @BotFather. Powers BOTH the in-process RunSpace bot
# (services/pingbot.py — /ping, /code) AND the HMAC check for the
# "Sign in with Telegram" widget. Leave unset to disable both.
# BOT_TOKEN is the name to use; TELEGRAM_PING_BOT_TOKEN still works.
# BOT_TOKEN=123456:AA...

# ⚠️ REQUIRED FOR THE MINI APP — this service's own public https URL.
#
# This is what the bot's "Open CodeNest" button opens. Telegram only accepts
# an https:// URL for a Mini App button, and the URL must be THIS deployment,
# because the site that receives the initData is the site that verifies it
# with BOT_TOKEN. Point it somewhere else and sign-in fails with bad_hash on a
# server you do not control.
#
# On Render this defaults to RENDER_EXTERNAL_URL automatically, so you only
# need to set it for a custom domain. Anywhere else, set it explicitly.
# Check what the running service resolved it to:  GET /health -> miniapp_url
#
# SITE_BASE_URL=https://your-service.onrender.com

# ONE SERVICE PER BOT TOKEN. The bot uses long polling; two deployments (or a
# local run left open) sharing a token split the updates between them and both
# appear dead. A webhook registered on the same token blocks polling outright
# — the bot now detects that and deletes it, and logs when it does.

# The bot's public @username (with or without the @). REQUIRED for the
# Telegram login widget to render — the frontend reads it from
# /api/public-config. Must be the same bot as the token above, and that
# bot's domain must be set via @BotFather -> /setdomain.
# TELEGRAM_BOT_USERNAME=MyCodeNestBot

# Default target for /ping when no URL is given.
# PING_DEFAULT_TARGET=https://ahadorg.onrender.com
# PING_TIMEOUT_S=8

# ---------------------------------------------------------------------------
# AUTH MODE / ABUSE PREVENTION TOGGLES
# ---------------------------------------------------------------------------
# Telegram-only sign-in (current scope). The email+password+OTP flow is still
# fully implemented server-side; set to 0 to show its UI again.
# TELEGRAM_ONLY_AUTH=1

# Cross-account protection is enabled by default (3 running bots/device,
# 9/network). Set to 0 only if you deliberately want per-account limits alone.
# CLUSTER_LIMITS_ENABLED=1
# FINGERPRINT_JOB_LIMIT=3
# IP_JOB_LIMIT=9

# Bot secrets (BOT_TOKEN, API keys) are stored as PLAIN JSON in your own
# database — no key to set, and nothing refuses to work without one. See
# services/secrets_store.py for the reasoning: an encryption key that gets lost
# or rotated means every restarted bot comes back without its token, which is
# how a bot "just dies".
#
# The ONLY reason to set JOB_SECRETS_KEY now is to unlock rows an older version
# encrypted ("enc:v1:…"). Keep the old value for ONE boot: the startup
# migration rewrites those rows as plain text, and after that the variable can
# be deleted for good. GET /health reports bot_secrets_legacy_rows — when it
# reaches 0, nothing encrypted is left.
# JOB_SECRETS_KEY=<the value this install used before>
#
# HMAC key for duplicate Telegram-token fingerprints. Independent of storage;
# changing it only resets duplicate detection, it never loses a token.
# JOB_TOKEN_HASH_KEY=<a random value>

# ── BOTS COMING BACK BY THEMSELVES ─────────────────────────────────────
# How often the site re-checks that every bot marked "should be running" really
# is, and re-creates it (code + env from the database, data from the last
# snapshot) if the runner lost it. This is what makes a runner redeploy or a
# free-tier spin-down a non-event instead of a dead bot nobody noticed.
# Default 300 (5 minutes). Set to 0 to switch the periodic pass off; the
# one-shot pass at site startup always runs.
# JOB_RECOVERY_INTERVAL_S=300

# Public multi-tenant deployments should use a remote isolated runner. Embedded
# mode executes user code in the main container and is for development/single
# owner use.
# RUNNER_SERVICE_URL=https://your-runner.example
# RUNNER_SERVICE_SECRET=<shared random value>

# Max seconds a single RunSpace log stream (SSE) stays open before the client
# is asked to reconnect. Prevents forgotten tabs pinning server connections.
# SSE_MAX_LIFETIME_S=900

# Operational data retention (cleanup runs at startup).
# BOT_EVENT_RETENTION_DAYS=180
# DEPLOY_EVENT_RETENTION_DAYS=365

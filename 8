# ---------- Git Data API (bulk, single-commit zip push) ----------

def gh_create_blob(owner, repo, content_bytes):
    payload = {"content": base64.b64encode(content_bytes).decode(), "encoding": "base64"}
    resp = requests.post(f"{GITHUB_API}/repos/{owner}/{repo}/git/blobs", headers=gh_headers(), json=payload)
    if resp.status_code == 409 and gh_try_bypass_push_protection(owner, repo, resp):
        resp = requests.post(f"{GITHUB_API}/repos/{owner}/{repo}/git/blobs", headers=gh_headers(), json=payload)  # retry after bypass
    return resp

def gh_create_tree(owner, repo, base_tree_sha, tree_items):
    return requests.post(f"{GITHUB_API}/repos/{owner}/{repo}/git/trees", headers=gh_headers(),
                          json={"base_tree": base_tree_sha, "tree": tree_items})

def gh_create_commit_obj(owner, repo, message, tree_sha, parent_sha):
    return requests.post(f"{GITHUB_API}/repos/{owner}/{repo}/git/commits", headers=gh_headers(),
                          json={"message": message, "tree": tree_sha, "parents": [parent_sha]})

def gh_update_ref(owner, repo, branch, commit_sha):
    return requests.patch(f"{GITHUB_API}/repos/{owner}/{repo}/git/refs/heads/{branch}", headers=gh_headers(),
                           json={"sha": commit_sha})

def gh_get_commit(owner, repo, sha):
    return requests.get(f"{GITHUB_API}/repos/{owner}/{repo}/git/commits/{sha}", headers=gh_headers())

def gh_push_zip(owner, repo, branch, files, message):
    """
    files: {path: bytes}. Pushes all of them to `branch` in ONE commit using
    the Git Data API (blob -> tree -> commit -> update ref).

    If the branch doesn't exist yet, it's created off the repo's default
    branch first. If the repo has NO commits at all yet (brand new repo),
    the Git Data API has nothing to attach to, so this falls back to
    pushing file-by-file with the plain Contents API instead (which is able
    to create the very first commit + branch on its own).

    Returns: (ok_count, total_count, commit_sha_or_None, error_or_None)
    """
    total = len(files)
    branch_sha = gh_get_branch_sha(owner, repo, branch)

    if branch_sha is None:
        info = gh_get_repo_info(owner, repo)
        default_branch = (info or {}).get("default_branch") or "main"
        default_sha = gh_get_branch_sha(owner, repo, default_branch)

        if default_sha is None:
            # totally empty repo, no commits anywhere yet -> bootstrap
            ok = 0
            for path, content in files.items():
                r = gh_put_file(owner, repo, branch, path, content, message)
                if r.status_code in (200, 201):
                    ok += 1
            err = None if ok == total else f"{total - ok}টা ফাইল push ব্যর্থ হয়েছে"
            return ok, total, None, err

        r = gh_create_branch(owner, repo, branch, default_branch)
        if not (r and r.status_code == 201):
            return 0, total, None, f"branch '{branch}' তৈরি করা যায়নি"
        branch_sha = default_sha

    commit_r = gh_get_commit(owner, repo, branch_sha)
    if commit_r.status_code != 200:
        return 0, total, None, f"branch-এর commit তথ্য পাওয়া যায়নি ({commit_r.status_code})"
    base_tree_sha = commit_r.json()["tree"]["sha"]

    tree_items = []
    for path, content in files.items():
        blob_r = gh_create_blob(owner, repo, content)
        if blob_r.status_code != 201:
            if blob_r.status_code == 409:
                return 0, total, None, (
                    f"'{path}' এ secret scanning block করেছে এবং auto-bypass ব্যর্থ হয়েছে "
                    "(token-এর bypass permission নেই বা delegated bypass চালু আছে repo-তে)"
                )
            return 0, total, None, f"'{path}' blob তৈরি ব্যর্থ ({blob_r.status_code})"
        tree_items.append({"path": path, "mode": "100644", "type": "blob", "sha": blob_r.json()["sha"]})

    tree_r = gh_create_tree(owner, repo, base_tree_sha, tree_items)
    if tree_r.status_code != 201:
        return 0, total, None, f"tree তৈরি ব্যর্থ ({tree_r.status_code})"

    commit_new_r = gh_create_commit_obj(owner, repo, message, tree_r.json()["sha"], branch_sha)
    if commit_new_r.status_code != 201:
        return 0, total, None, f"commit তৈরি ব্যর্থ ({commit_new_r.status_code})"
    new_sha = commit_new_r.json()["sha"]

    update_r = gh_update_ref(owner, repo, branch, new_sha)
    if update_r.status_code != 200:
        return 0, total, None, f"branch ref আপডেট ব্যর্থ ({update_r.status_code})"

    return total, total, new_sha, None

def extract_zip_files(raw_bytes):
    """Returns {path: bytes} for every real file in the zip (skips folders
    and anything that tries to escape the target directory). No folder
    stripping happens here -- see the zx:extract button handler, which
    decides (or asks) whether to strip a wrapping folder."""
    files = {}
    with zipfile.ZipFile(io.BytesIO(raw_bytes)) as zf:
        for info in zf.infolist():
            if info.is_dir():
                continue
            name = info.filename.replace("\\", "/")
            if name.startswith("/") or ".." in name.split("/"):
                continue
            files[name] = zf.read(info)
    return files


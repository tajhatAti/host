        s["awaiting"] = "newbranch"
        await q.edit_message_text(
            f"নতুন branch-র নাম লিখে পাঠান (এটা তৈরি হবে '{s['branch']}' থেকে):",
            reply_markup=add_home(),
        )
        return

    if data == "menu:setrepo":
        s["awaiting"] = "setrepo"
        await q.edit_message_text("owner/repo ফরম্যাটে লিখে পাঠান (যেমন: tajhatati/host):", reply_markup=add_home())
        return

    if data == "menu:workflows":
        r = gh_list_workflows(s["owner"], s["repo"])
        if r.status_code != 200:
            text = f"error {r.status_code}"
        else:
            items = r.json().get("workflows", [])
            text = "\n".join(f"{x['id']} | {x['name']} | {x['state']}" for x in items) or "কোনো workflow নেই"
        await q.edit_message_text(text, reply_markup=add_home())
        return

    if data == "menu:runs":
        r = gh_list_runs(s["owner"], s["repo"])
        if r.status_code != 200:
            await q.edit_message_text(f"error {r.status_code}", reply_markup=add_home())
            return
        items = r.json().get("workflow_runs", [])
        if not items:
            await q.edit_message_text("কোনো run নেই", reply_markup=add_home())
            return
        s["cache_runs"] = [x["id"] for x in items]
        rows = [[InlineKeyboardButton(f"{x['name'][:20]} | {x['status']}/{x['conclusion']} | {x['head_branch']}", callback_data=f"rn:{i}")] for i, x in enumerate(items)]
        await q.edit_message_text("run বেছে নিন:", reply_markup=add_home(rows))
        return

    if data == "menu:releases":
        r = gh_list_releases(s["owner"], s["repo"])
        if r.status_code != 200:
            await q.edit_message_text(f"error {r.status_code}", reply_markup=add_home())
            return
        items = r.json()
        if not items:
            await q.edit_message_text("কোনো release নেই", reply_markup=add_home())
            return
        s["cache_releases"] = [x["id"] for x in items]
        rows = [[InlineKeyboardButton(f"{x['tag_name']} - {x['name']} ({len(x['assets'])} file)", callback_data=f"rl:{i}")] for i, x in enumerate(items)]
        await q.edit_message_text("release বেছে নিন:", reply_markup=add_home(rows))
        return

    if data == "menu:history":
        data_hist = load_history()[:20]
        if not data_hist:
            text = "কোনো history নেই"
        else:
            text = "\n".join(f"{h['time'][:16]} | {h.get('repo','')} | {h['user']} | {h['action']} | {h['path']}" for h in data_hist)
        await q.edit_message_text(text, reply_markup=add_home())
        return

    if data == "menu:status":
        info = gh_get_repo_info(s["owner"], s["repo"])
        gh_default = (info or {}).get("default_branch", "?")
        text = (
            f"repo: {repo_link_html(s['owner'], s['repo'])}\n"
            f"একটিভ branch: {branch_link_html(s['owner'], s['repo'], s['branch'])}\n"
            f"GitHub-এ default branch: {esc(gh_default)}"
        )
        await q.edit_message_text(text, reply_markup=add_home(), parse_mode="HTML")
        return

    # ----- zip upload confirmation -----
    if data.startswith("zx:"):
        action = data.split(":", 1)[1]
        pending = pending_files.get(chat_id)
        if not pending:
            await q.edit_message_text("এই ফাইলটা আর পাওয়া যাচ্ছে না, আবার পাঠান।", reply_markup=add_home())
            return

        if action == "cancel":
            pending_files.pop(chat_id, None)
            await q.edit_message_text("❌ বাতিল করা হলো", reply_markup=add_home())
            return

        if action == "asis":
            await q.edit_message_text(f"ঠিক আছে। '{pending['filename']}' কোন path-এ রাখব লিখে পাঠান (যেমন: releases/{pending['filename']})")
            return

        if action == "extract":
            await q.edit_message_text("📦 Zip পড়া হচ্ছে...")
            try:
                files = extract_zip_files(pending["bytes"])
            except zipfile.BadZipFile:
                pending_files.pop(chat_id, None)
                await q.edit_message_text("❌ এটা সঠিক .zip ফাইল বলে মনে হচ্ছে না।", reply_markup=add_home())
                return
            if not files:
                pending_files.pop(chat_id, None)
                await q.edit_message_text("❌ Zip-এর ভেতরে কোনো ফাইল পাওয়া যায়নি।", reply_markup=add_home())
                return

            tops = sorted({p.split("/", 1)[0] for p in files if "/" in p})
            root_files_exist = any("/" not in p for p in files)

            if len(tops) == 1 and not root_files_exist:
                # exactly one folder wraps EVERYTHING -> safe to auto-strip, no need to ask
                prefix = tops[0] + "/"
                push_files = {p[len(prefix):]: c for p, c in files.items()}
                await _do_zip_push(q, s, chat_id, user, push_files, pending["filename"])
                pending_files.pop(chat_id, None)
                return

            if not tops:
                # nothing is nested at all, already flat -> push as-is
                await _do_zip_push(q, s, chat_id, user, files, pending["filename"])
                pending_files.pop(chat_id, None)
                return

            # ambiguous: more than one top-level folder, or a mix of root
            # files + folders -> ask which one should become the repo root,
            # instead of guessing (this was the bug: guessing wrong silently
            # nested everything and broke GitHub Actions).
            pending["zip_extracted"] = files
            s["cache_zip_tops"] = tops
            rows = [
                [InlineKeyboardButton(f"📂 {name}/ এর ভেতরটা রুটে বসাও", callback_data=f"zxroot:{i}")]
                for i, name in enumerate(tops)
            ]
            rows.append([InlineKeyboardButton("📦 সবকিছু যেভাবে আছে সেভাবেই push করো", callback_data="zxroot:asis")])
            rows.append([InlineKeyboardButton("❌ বাতিল", callback_data="zx:cancel")])
            note = " (এবং কিছু ফাইল zip-এর একদম রুটেও আছে)" if root_files_exist else ""
            await q.edit_message_text(
                f"এই zip-এ একাধিক ফোল্ডার/আইটেম পাওয়া গেছে{note}: {', '.join(tops)}\n\n"
                "কোন ফোল্ডারের ভেতরের কনটেন্টটা repo-র রুটে বসাতে চান? (বাকিগুলো বাদ যাবে) "
                "নাকি সব যেমন আছে তেমনি রাখবেন?",
                reply_markup=kb(rows),
            )
            return

    if data.startswith("zxroot:"):
        sel = data.split(":", 1)[1]
        pending = pending_files.get(chat_id)
        if not pending or "zip_extracted" not in pending:
            await q.edit_message_text("এই zip-টা আর পাওয়া যাচ্ছে না, আবার পাঠান।", reply_markup=add_home())
            return
        files = pending["zip_extracted"]

        if sel == "asis":
            push_files = files
        else:
            idx = int(sel)
            tops = s.get("cache_zip_tops", [])
            if idx >= len(tops):
                await q.edit_message_text("ভুল সিলেকশন, আবার zip পাঠান।", reply_markup=add_home())
                pending_files.pop(chat_id, None)
                return
            prefix = tops[idx] + "/"
            push_files = {p[len(prefix):]: c for p, c in files.items() if p.startswith(prefix)}
            if not push_files:
                await q.edit_message_text(f"'{tops[idx]}' ফোল্ডারে কোনো ফাইল পাওয়া যায়নি।", reply_markup=add_home())
                pending_files.pop(chat_id, None)
                return

        await _do_zip_push(q, s, chat_id, user, push_files, pending["filename"])
        pending_files.pop(chat_id, None)
        return

    # ----- existing feature callbacks -----
    if data.startswith("ls:"):
        idx = int(data.split(":")[1])
        typ, path = s["cache_list"][idx]
        if typ == "dir":
            text, markup = await show_list(chat_id, path)
            await q.edit_message_text(text, reply_markup=markup)
        else:
            result = gh_get_file_bytes(s["owner"], s["repo"], s["branch"], path)
            if result:
                content, name = result
                await q.message.reply_document(document=io.BytesIO(content), filename=name)
                log_action(chat_id, user, "download", path)

    elif data.startswith("lsup:"):
        path = data.split(":", 1)[1]
        text, markup = await show_list(chat_id, path)
        await q.edit_message_text(text, reply_markup=markup)

    elif data.startswith("br:"):
        idx = int(data.split(":")[1])
        name = s["cache_branches"][idx]
        s["branch"] = name
        await q.edit_message_text(f"now using branch {name}", reply_markup=add_home())

    elif data.startswith("rp:"):
        idx = int(data.split(":")[1])
        owner, repo = s["cache_repos"][idx].split("/", 1)
        # FIX (the reported bug): re-sync branch to the NEW repo's own default
        # branch instead of carrying over whatever branch was active before.
        info = gh_get_repo_info(owner, repo)
        s["owner"], s["repo"] = owner, repo
        s["branch"] = (info or {}).get("default_branch") or "main"
        await q.edit_message_text(f"now working on {owner}/{repo} (branch: {s['branch']})", reply_markup=add_home())

    elif data.startswith("rn:"):
        idx = int(data.split(":")[1])
        run_id = s["cache_runs"][idx]
        r = gh_list_artifacts(s["owner"], s["repo"], run_id)
        if r.status_code != 200:
            await q.edit_message_text(f"error {r.status_code}", reply_markup=add_home())
            return
        items = r.json().get("artifacts", [])
        if not items:
            await q.edit_message_text("no artifacts for this run", reply_markup=add_home())
            return
        s["cache_artifacts"] = [x["id"] for x in items]
        rows = [[InlineKeyboardButton(f"{x['name']} ({round(x['size_in_bytes']/1024/1024,1)}MB)", callback_data=f"at:{i}")] for i, x in enumerate(items)]
        await q.edit_message_text("tap to download:", reply_markup=add_home(rows))

    elif data.startswith("at:"):
        idx = int(data.split(":")[1])
        artifact_id = s["cache_artifacts"][idx]
        await q.edit_message_text("downloading...")
        r = gh_download_artifact(s["owner"], s["repo"], artifact_id)
        if r.status_code == 200:
            await q.message.reply_document(document=io.BytesIO(r.content), filename=f"artifact_{artifact_id}.zip")
            log_action(chat_id, user, "download_artifact", str(artifact_id))
        else:
            await q.message.reply_text(f"error {r.status_code}")

    elif data.startswith("rl:"):
        idx = int(data.split(":")[1])
        release_id = s["cache_releases"][idx]
        r = gh_get_release(s["owner"], s["repo"], release_id)
        if r.status_code != 200:
            await q.edit_message_text(f"error {r.status_code}", reply_markup=add_home())
            return
        x = r.json()
        s["cache_assets"] = [a["id"] for a in x["assets"]]
        rows = [[InlineKeyboardButton(f"{a['name']} ({round(a['size']/1024/1024,1)}MB)", callback_data=f"as:{i}")] for i, a in enumerate(x["assets"])]
        text = f"{x['tag_name']} - {x['name']}"
        await q.edit_message_text(text, reply_markup=add_home(rows))

    elif data.startswith("as:"):
        idx = int(data.split(":")[1])
        asset_id = s["cache_assets"][idx]
        await q.edit_message_text("downloading...")
        r = gh_download_asset(s["owner"], s["repo"], asset_id)
        if r.status_code == 200:
            fname = r.headers.get("Content-Disposition", "").split("filename=")[-1].strip('"') or f"asset_{asset_id}"
            await q.message.reply_document(document=io.BytesIO(r.content), filename=fname)
            log_action(chat_id, user, "download_asset", fname)
        else:
            await q.message.reply_text(f"error {r.status_code}")

def main():
    app = ApplicationBuilder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("menu", start))
    app.add_handler(CommandHandler("list", list_files))
    app.add_handler(CommandHandler("get", get_file))
    app.add_handler(CommandHandler("getfolder", get_folder))
    app.add_handler(CommandHandler("getrepo", get_repo))
    app.add_handler(CommandHandler("delete", delete_file))
    app.add_handler(CommandHandler("history", history))
    app.add_handler(CommandHandler("branches", branches))
    app.add_handler(CommandHandler("newbranch", new_branch))
    app.add_handler(CommandHandler("delbranch", del_branch))
    app.add_handler(CommandHandler("setdefault", set_default))
    app.add_handler(CommandHandler("repos", list_repos))
    app.add_handler(CommandHandler("newrepo", new_repo))
    app.add_handler(CommandHandler("delrepo", del_repo))
    app.add_handler(CommandHandler("setrepo", set_repo))
    app.add_handler(CommandHandler("desc", set_desc))
    app.add_handler(CommandHandler("workflows", workflows))
    app.add_handler(CommandHandler("run", run_workflow))
    app.add_handler(CommandHandler("runs", runs))
    app.add_handler(CommandHandler("artifacts", artifacts))
    app.add_handler(CommandHandler("download", download_artifact))
    app.add_handler(CommandHandler("releases", releases))
    app.add_handler(CommandHandler("latest", latest))
    app.add_handler(CommandHandler("getasset", get_asset))
    app.add_handler(CommandHandler("newrelease", new_release))
    app.add_handler(CallbackQueryHandler(on_button))
    app.add_handler(MessageHandler(filters.Document.ALL, handle_document))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.run_polling()

if __name__ == "__main__":
    main()

async def handle_document(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    s = get_state(chat_id)
    doc = update.message.document
    tg_file = await doc.get_file()
    file_bytes = await tg_file.download_as_bytearray()

    if s.get("pending_release_upload_url"):
        await update.message.reply_text("attaching to release...")
        r = gh_upload_asset(s["pending_release_upload_url"], doc.file_name, bytes(file_bytes))
        s["pending_release_upload_url"] = None
        if r.status_code == 201:
            await update.message.reply_text(f"attached: {r.json().get('browser_download_url')}")
            log_action(chat_id, update.effective_user.username or str(update.effective_user.id), "release_asset_upload", doc.file_name)
        else:
            await update.message.reply_text(f"error {r.status_code}: {r.text[:300]}")
        return

    pending_files[chat_id] = {"bytes": bytes(file_bytes), "filename": doc.file_name}

    if doc.file_name and doc.file_name.lower().endswith(".zip"):
        rows = [
            [InlineKeyboardButton("📦 Extract করে সব ফাইল Push করুন", callback_data="zx:extract")],
            [InlineKeyboardButton("📄 .zip হিসেবেই আপলোড করুন", callback_data="zx:asis")],
            [InlineKeyboardButton("❌ বাতিল", callback_data="zx:cancel")],
        ]
        await update.message.reply_text(
            f"'{esc(doc.file_name)}' পেয়েছি — কী করব?\n"
            f"(Extract করলে {repo_link_html(s['owner'], s['repo'])} রিপোর "
            f"{branch_link_html(s['owner'], s['repo'], s['branch'])} branch-এ এক কমিটে push হবে)",
            reply_markup=kb(rows),
            parse_mode="HTML",
        )
    else:
        await update.message.reply_text(f"got {doc.file_name}. path? (e.g. static/app.css)")

async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat_id = update.effective_chat.id
    s = get_state(chat_id)
    txt = update.message.text.strip()
    user = update.effective_user.username or str(update.effective_user.id)

    awaiting = s.get("awaiting")

    if awaiting == "newrepo":
        s["awaiting"] = None
        parts = txt.split()
        name = parts[0]
        private = len(parts) > 1 and parts[1].lower() == "private"
        r = gh_create_repo(name, private)
        if r.status_code == 201:
            d = r.json()
            s["owner"], s["repo"] = d["owner"]["login"], d["name"]
            s["branch"] = d.get("default_branch") or "main"
            await update.message.reply_text(
                f"✅ তৈরি হলো ও একটিভ করা হলো: {s['owner']}/{s['repo']} (branch: {s['branch']})",
                reply_markup=add_home(),
            )
            log_action(chat_id, user, "new_repo", name)
        else:
            await update.message.reply_text(f"error {r.status_code}: {r.text[:300]}", reply_markup=add_home())
        return

    if awaiting == "newbranch":
        s["awaiting"] = None
        name = txt.split()[0]
        src = s["branch"]
        r = gh_create_branch(s["owner"], s["repo"], name, src)
        if r and r.status_code == 201:
            s["branch"] = name
            await update.message.reply_text(f"✅ '{name}' তৈরি হলো ({src} থেকে) ও একটিভ করা হলো", reply_markup=add_home())
            log_action(chat_id, user, "new_branch", name, src)
        else:
            await update.message.reply_text(
                f"error: {r.text[:300] if r else 'source branch not found'}", reply_markup=add_home()
            )
        return

    if awaiting == "setrepo":
        s["awaiting"] = None
        if "/" not in txt:
            await update.message.reply_text("owner/repo ফরম্যাটে দিন", reply_markup=add_home())
            return
        owner, repo = txt.split("/", 1)
        info = gh_get_repo_info(owner, repo)
        if not info:
            await update.message.reply_text("repo পাওয়া যায়নি বা অ্যাক্সেস নেই", reply_markup=add_home())
            return
        s["owner"], s["repo"] = owner, repo
        s["branch"] = info.get("default_branch") or "main"
        await update.message.reply_text(f"✅ একটিভ repo: {owner}/{repo} (branch: {s['branch']})", reply_markup=add_home())
        return

    # default flow: this text is the destination path for a previously sent file
    pending = pending_files.get(chat_id)
    if not pending:
        await update.message.reply_text("send a file first, or use /menu")
        return
    path = txt.lstrip("/")
    resp = gh_put_file(s["owner"], s["repo"], s["branch"], path, pending["bytes"], f"Update {path}")
    if resp.status_code in (200, 201):
        url = resp.json()["content"]["html_url"]
        await update.message.reply_text(url, reply_markup=add_home())
        log_action(chat_id, user, "upload", path, pending["filename"])
    elif resp.status_code == 409:
        await update.message.reply_text(
            "⚠️ secret scanning block করেছে এবং auto-bypass ব্যর্থ হয়েছে "
            "(token-এর bypass permission নেই বা delegated bypass চালু আছে repo-তে)।",
            reply_markup=add_home(),
        )
    else:
        await update.message.reply_text(f"error {resp.status_code}: {resp.text[:300]}", reply_markup=add_home())
    pending_files.pop(chat_id, None)


async def get_folder(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("usage: /getfolder path/to/folder")
        return
    s = get_state(update.effective_chat.id)
    path = context.args[0].lstrip("/")
    await update.message.reply_text("packaging...")
    files = gh_walk_files(s["owner"], s["repo"], s["branch"], path)
    if not files:
        await update.message.reply_text("empty or not found")
        return
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as zf:
        for f in files:
            result = gh_get_file_bytes(s["owner"], s["repo"], s["branch"], f)
            if result:
                zf.writestr(f, result[0])
    buf.seek(0)
    name = path.strip("/").split("/")[-1] or s["repo"]
    await update.message.reply_document(document=buf, filename=f"{name}.zip")
    log_action(update.effective_chat.id, update.effective_user.username or str(update.effective_user.id), "download_folder", path)

